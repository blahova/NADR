   RowBox[{"u", "[", 
    RowBox[{"x_", ",", "y_", ",", "t_", ",", "d_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "*", "Pi", "*", "t", "*", 
      RowBox[{"Det", "[", "d", "]"}]}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "]"}], ".", 
        RowBox[{"Inverse", "[", "d", "]"}], ".", 
        RowBox[{"{", 
