Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", "*", "Pi", "*", "t", "*", 
      RowBox[{"Det", "[", "d", "]"}]}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "]"}], ".", 
        RowBox[{"Inverse", "[", "d", "]"}], ".", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}]}], 
       RowBox[{"4", "*", "t"}]]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9844895304765625`*^9, 3.984489539617317*^9}, {
